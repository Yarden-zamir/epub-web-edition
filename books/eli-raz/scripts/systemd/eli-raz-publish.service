[Unit]
Description=Publish the Eli Raz book site when its repos change

[Service]
Type=oneshot
WorkingDirectory=%h/Github/eli-raz-edition/main
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run %h/Github/eli-raz-edition/main/scripts/publish_release.py
TimeoutStartSec=45min
